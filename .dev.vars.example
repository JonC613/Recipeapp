# CLOUDFLARE_WORKER_NAME="recipeapp"
# CLOUDFLARE_D1_DATABASE_ID="replace-with-d1-database-id"
# CLOUDFLARE_R2_BUCKET_NAME="recipeapp-sources"
# OPENAI_ADMIN_API_KEY="replace-with-openai-admin-reporting-key"
